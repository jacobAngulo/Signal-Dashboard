[Unit]
Description=Signal Dashboard (LSTM + Intrinsic + Foundry signal analytics UI)
After=network.target av-gateway.service
Wants=av-gateway.service

[Service]
Type=simple
WorkingDirectory=/projects/Signal-Dashboard
Environment=PYTHONUNBUFFERED=1
Environment=AV_GATEWAY_URL=http://127.0.0.1:8765
ExecStart=/projects/Signal-Dashboard/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
